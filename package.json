{
  "name": "medverse-takehome",
  "private": true,
  "workspaces": [
    "functions",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "test": "npm run test --workspace functions",
    "test:rules": "npm run test:rules --workspace functions",
    "build": "npm run build --workspace functions && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "15.5.25",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  }
}
